APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_ORIGIN=http://127.0.0.1:8000

# Authentication (required by default)
# Create a Google Web OAuth client and authorize:
#   https://writing.gggxie.com
AUTH_REQUIRED=true
GOOGLE_CLIENT_ID=
AUTH_ALLOWED_EMAILS=gavinxie1219@gmail.com
# Optional; when empty, sessions are invalidated after every service restart.
SESSION_SECRET_KEY=
SESSION_TTL_SECONDS=43200
MAX_REQUEST_BYTES=1048576
MAX_CONCURRENT_GENERATIONS=2

# Text generation
# Direct OpenAI API: leave OPENAI_BASE_URL empty and use a Platform API key.
# CLIProxyAPI: set OPENAI_BASE_URL=http://127.0.0.1:8317/v1 and use the
# local api-keys entry from /etc/cliproxyapi/config.yaml.
OPENAI_API_KEY=
OPENAI_BASE_URL=
TEXT_MODEL_NAME=gpt-5.6-terra
TEXT_REQUEST_TIMEOUT_SECONDS=180
TEXT_MAX_RETRIES=3

# Image generation
# Codex OAuth through CLIProxyAPI: set IMAGE_MODEL_NAME=gpt-image-2 and leave
# IMAGE_API_KEY / IMAGE_BASE_URL empty to reuse OPENAI_API_KEY / OPENAI_BASE_URL.
# Direct OpenAI API: use a Platform API key and a currently supported GPT Image model.
IMAGE_MODEL_NAME=svg-fallback
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_REQUEST_TIMEOUT_SECONDS=240
IMAGE_QUALITY=low
IMAGE_SIZE=1024x1024
IMAGE_MAX_CONCURRENCY=2
IMAGE_OUTPUT_DIR=generated_images

# Editorial workspace and resources
EDITORIAL_WORKSPACE_DIR=workspace
EDITORIAL_RESOURCES_DIR=resources/editorial
SOURCES_CONFIG_PATH=config/sources.yaml
COLLECTOR_DATABASE_PATH=workspace/.collector.sqlite3
SOURCE_REQUEST_TIMEOUT_SECONDS=20

# X API v2 Filtered Stream（仅启用 X 采集时需要）
X_BEARER_TOKEN=

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=writing-agent

# Optional search / research providers
TAVILY_API_KEY=
