APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_ORIGIN=http://127.0.0.1:8000

# Text generation
OPENAI_API_KEY=
OPENAI_BASE_URL=
TEXT_MODEL_NAME=gpt-4o-mini

# Image generation
IMAGE_MODEL_NAME=svg-fallback
IMAGE_OUTPUT_DIR=generated_images

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=writing-agent

# Optional search / research providers
TAVILY_API_KEY=
