# RSSHub is a private local sidecar for this box's own outbound access to
# public RSS sources (incl. X/Twitter). Do not expose port 1200 through
# Cloudflare, a reverse proxy, or a public network interface — see
# deploy/rsshub.service (binds 127.0.0.1 only).
#
# 下面的值不是 shell 语法，不要加引号：CACHE_EXPIRE=1800 是对的，
# CACHE_EXPIRE="1800" 会把引号字符也当成值的一部分。

CACHE_EXPIRE=1800
CACHE_TYPE=memory
NO_LOGFILES=true

# TWITTER_AUTH_TOKEN 不需要填你的真实凭据。实测确认：只要这个变量非空，
# RSSHub 就会启用它的 Twitter 集成分支，该分支对公开账号/公开 List 的读取
# 会用内置的匿名 guest token 流程完成，并不会校验这个值本身是否真实有效
# ——留一个任意占位字符串即可，不涉及你个人账号，没有账号被限流/冻结的风险。
#
# 只有在之后遇到限流、拉不到数据，或者需要读取非公开内容时，才需要把下面
# 这行换成你自己 X 账号登录后从浏览器 DevTools 的 Storage/Cookies 面板复制
# 的真实 auth_token 值（不是 document.cookie，因为它是 HttpOnly 的）。这属于
# 用个人账号做非官方自动化访问，违反 X 服务条款，存在账号被限流甚至冻结的
# 风险，请自行评估后再启用。
TWITTER_AUTH_TOKEN=any-non-empty-placeholder-value
